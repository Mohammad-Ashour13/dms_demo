[Unit]
Description=Safee Driver Monitoring System
After=network-online.target safee-dms-cpu-cap.service
Wants=network-online.target

[Service]
Type=simple
User=safee
Group=safee
SupplementaryGroups=video render gpio
WorkingDirectory=/opt/safee-dms
ExecStart=/opt/safee-dms/.venv/bin/dms-runtime --config /opt/safee-dms/configs/runtime.raspberry_pi5.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/safee-dms/incidents /opt/safee-dms/logs

[Install]
WantedBy=multi-user.target
