{
  "camera": {
    "source": 0,
    "width": 640,
    "height": 480,
    "fps": 15.0,
    "ai_queue_size": 2
  },
  "perception": {
    "face_landmarker_path": "models/mediapipe/face_landmarker.task",
    "min_detection_confidence": 0.5,
    "min_tracking_confidence": 0.5,
    "min_face_quality": 0.55,
    "min_eye_signal_quality": 0.45,
    "max_eye_pose_deg": 25.0,
    "max_eye_asymmetry_ratio": 0.45,
    "min_face_width_ratio": 0.20,
    "min_interocular_distance_px": 50.0,
    "min_eye_width_px": 24.0
  },
  "telemetry": {
    "log_dir": "logs",
    "mode": "DEBUG",
