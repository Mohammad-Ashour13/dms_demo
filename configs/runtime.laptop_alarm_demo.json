    "minimum_samples": 3,
    "activation_ratio": 0.6,
    "activation_persistence_sec": 0.5,
    "clear_persistence_sec": 2.0,
    "evidence_refresh_sec": 1.0,
    "evidence_ttl_sec": 2.5,
    "class_thresholds": {
      "phone": 0.4,
      "cigarette": 0.3,
      "drink_or_food": 0.35
