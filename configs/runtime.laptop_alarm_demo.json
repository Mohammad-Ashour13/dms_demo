    "manifest_path": "models/seatbelt/risef_yolov11s/model_manifest.json",
    "image_size": 224,
    "ncnn_num_threads": 1,
    "inference_interval_sec": 2.0,
    "queue_size": 1,
    "no_seatbelt_threshold": 0.80,
    "clear_threshold": 0.60,
