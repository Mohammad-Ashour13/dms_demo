    "evidence_refresh_sec": 2.0,
    "evidence_ttl_sec": 4.5,
    "roi_width_scale": 2.8,
    "roi_height_scale": 3.1,
    "roi_top_offset": -0.15,
    "roi_min_size": 128,
    "shadow_mode": true
